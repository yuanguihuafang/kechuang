# 科创后端配置示例：复制为 backend/.env 后按实际环境填写。
# 不要将 .env、.env.local 或真实密钥提交到 Git。
# 从 backend 目录启动时，.env.local 会覆盖 .env 中的同名配置。

# 后端与浏览器访问地址
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8793
PUBLIC_API_BASE_URL=http://127.0.0.1:8793
CORS_ORIGINS=http://localhost:8794,http://127.0.0.1:8794
# 必须替换为独立生成的随机密钥，生产环境不能使用示例值。
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# PostgreSQL：替换用户、密码和数据库名。
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:5432/YOUR_DATABASE

# 业务 MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=YOUR_USER
MYSQL_PASSWORD=YOUR_PASSWORD
MYSQL_DATABASE=YOUR_BUSINESS_DATABASE

# 用户身份 MySQL，可与业务 MySQL 位于同一实例，但需独立配置。
MYSQL_IDENTITY_ENABLED=true
MYSQL_IDENTITY_HOST=127.0.0.1
MYSQL_IDENTITY_PORT=3306
MYSQL_IDENTITY_USER=YOUR_USER
MYSQL_IDENTITY_PASSWORD=YOUR_PASSWORD
MYSQL_IDENTITY_DATABASE=YOUR_IDENTITY_DATABASE

# Milvus 与对象存储
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DATABASE=kechuang
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=YOUR_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_SECRET_KEY
MINIO_BUCKET=kechuang

# 向量嵌入与重排服务，按实际部署地址设置。
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
RERANK_ENABLED=true
RERANKER_URL=http://127.0.0.1:9998/v1/rerank
RERANKER_MODEL=bge-reranker-large

# 模型服务：根据供应商配置。需要时再启用联网搜索、视觉及语音服务。
LLM_PROVIDER=YOUR_PROVIDER
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=YOUR_MODEL
# TAVILY_API_KEY=YOUR_TAVILY_API_KEY

# 文档解析：使用远程 MinerU 时填写其服务地址。
DOCUMENT_PARSER=mineru
MINERU_URL=http://127.0.0.1:8000
ASR_ENABLED=false

# 智能问答依赖 DeerFlow；使用前需同时配置服务地址和认证信息。
DEERFLOW_ENABLED=false
# DEERFLOW_BASE_URL=http://127.0.0.1:8001
# DEER_FLOW_INTERNAL_AUTH_TOKEN=YOUR_INTERNAL_AUTH_TOKEN
# DEERFLOW_AGENT_OWNER_USER_ID=YOUR_AGENT_OWNER_USER_ID
